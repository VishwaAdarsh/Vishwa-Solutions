# Vishwa Solutions — SMTP & Notification Configuration Example
# Copy this file to .env and provide your production credentials
# NEVER commit your actual .env file to GitHub.

# SMTP Server Details
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=enquiries@yourdomain.com
SMTP_PASSWORD=your_secure_smtp_password
SMTP_FROM="Vishwa Solutions Enquiries" <enquiries@yourdomain.com>

# Business Notification Recipient (where enquiries are sent)
NOTIFICATION_EMAIL=vishwasolutions199@gmail.com

# Existing Google Apps Script Endpoint (records to Google Sheets)
GOOGLE_SHEET_SCRIPT_URL=https://script.google.com/macros/s/AKfycbzLrbcE1nOCpPruNvNsdm06EU0KSehLvErMP3Anq6ZypbssmNxUo8Wi4HAIMSWq0ZoU/exec
